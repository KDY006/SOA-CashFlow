    {
      "name": "1. Auth Service (Java Native - 8081)",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"testuser@cashflow.local\",\n  \"password\": \"password123\",\n  \"fullName\": \"Nguyen Van Test\",\n  \"phoneNumber\": \"0988776655\"\n}"
            },
            "url": {
              "raw": "{{GATEWAY_URL}}/api/auth/register",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["api", "auth", "register"]
            }
          }
        },
        {
          "name": "Login (Tự động gán ACCESS_TOKEN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.environment.set(\"ACCESS_TOKEN\", jsonData.accessToken);",
                  "    console.log(\"Saved ACCESS_TOKEN:\", jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{GATEWAY_URL}}/api/auth/login",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Validate JWT Token",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{ACCESS_TOKEN}}" }
            ],
            "url": {
              "raw": "{{GATEWAY_URL}}/api/auth/validate",
              "host": ["{{GATEWAY_URL}}"],
              "path": ["api", "auth", "validate"]
            }
          }
        },
        {
