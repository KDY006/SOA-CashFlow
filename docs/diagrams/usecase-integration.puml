@startuml
' ================================================================
' Sơ đồ Use Case - Integration Service (Go :8085)
' Đối chiếu với: server.go, accounts.go, webhook.go, rates.go, sync.go, simulate.go
' ================================================================
left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam nodesep 16
skinparam ranksep 55

skinparam ArrowColor #334155
skinparam ArrowThickness 1.1

skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #1E293B
  FontColor #0F172A
}

skinparam usecase {
  BackgroundColor #F8FAFC
  BorderColor #334155
  FontColor #0F172A
}

skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #334155
  FontColor #0F172A
}

title Sơ đồ Use Case — Integration Service (Go net/http :8085)

' === TÁC NHÂN BÊN TRÁI ===
actor "Người dùng\nCashFlow" as User
actor "Ngân hàng / Ví điện tử\n(Đối tác Webhook)" as Bank
actor "Người kiểm thử /\nVận hành" as Tester

' === PHẠM VI HỆ THỐNG ===
rectangle "INTEGRATION SERVICE (:8085)" {

  usecase "UC01: Liên kết tài khoản ngân hàng / ví" as UC01
  usecase "UC02: Xem danh sách & chi tiết tài khoản" as UC02
  usecase "UC03: Hủy liên kết tài khoản ngân hàng" as UC03
  usecase "UC04: Xem lịch sử & chi tiết biến động số dư" as UC04
  usecase "UC05: Xóa lịch sử biến động (Xóa lẻ / Xóa nhiều theo ID)" as UC05
  usecase "UC06: Đồng bộ lại giao dịch lỗi (Retry FAILED)" as UC06
  usecase "UC07: Tra cứu tỷ giá ngoại tệ" as UC07
  usecase "UC08: Đồng bộ tỷ giá song song (Goroutine)" as UC08
  usecase "UC09: Nhận Webhook biến động số dư" as UC09
  usecase "UC10: Giả lập tải đồng thời (Safe / Unsafe mode)" as UC10
  usecase "UC11: Kiểm tra trạng thái dịch vụ (Health Check)" as UC11

  usecase "Kiểm tra Idempotency\n& Khóa số dư tài khoản" as UC_IDEM
  usecase "Xác thực chữ ký\nHMAC-SHA256" as UC_SIG
  usecase "Đồng bộ giao dịch nền\nsang Transaction Service" as UC_SYNC
  usecase "Gửi cảnh báo biến động lớn /\nvượt ngân sách" as UC_ALERT
}

' === HỆ THỐNG LIÊN KẾT BÊN PHẢI ===
actor "Nguồn tỷ giá\n(VCB / TCB / BIDV)" as RateSource
actor "Transaction Service\n(PHP :8082)" as TxSvc
actor "Notification Service\n(Node.js :8086)" as NotiSvc

' === TÁC NHÂN CHÍNH (TRÁI -> GIỮA) ===
User -- UC01
User -- UC02
User -- UC03
User -- UC04
User -- UC05
User -- UC06
User -- UC07
User -- UC08

Bank -- UC09

Tester -- UC10
Tester -- UC11

' === INCLUDE / EXTEND (CỘT GIỮA 1 -> CỘT GIỮA 2) ===
UC09 ..> UC_IDEM : <<include>>
UC09 <.. UC_SIG : <<extend>>
UC09 ..> UC_SYNC : <<include>>
UC06 ..> UC_SYNC : <<include>>
UC09 <.. UC_ALERT : <<extend>>

' === HỆ THỐNG BÊN PHẢI (CỘT GIỮA -> CỘT PHẢI) ===
UC08 -- RateSource
UC_SYNC -- TxSvc
UC_ALERT -- NotiSvc

' Căn thẳng cột hệ thống bên phải
UC_IDEM -[hidden]-> RateSource

@enduml
