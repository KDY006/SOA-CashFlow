  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "UserIdQuery": {
        "name": "user_id",
        "in": "query",
        "required": false,
        "description": "**Chỉ ADMIN dùng được** — xem dữ liệu của user khác (vd 1, 2, 3...). Tài khoản USER thường: tham số này bị bỏ qua, luôn trả dữ liệu của chính mình (lấy userId từ JWT). Bỏ trống = dữ liệu của user đang đăng nhập.",
        "schema": {
          "type": "integer",
          "format": "int64",
          "minimum": 1
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Tham số không hợp lệ",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "user_id must be a positive integer"
            }
          }
        }
      },
      "RecordNotFound": {
        "description": "Không tìm thấy bản ghi của người dùng",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Record not found"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Thiếu hoặc sai JWT (do API Gateway trả về)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GatewayError"
            },
            "example": {
              "success": false,
              "error": "UNAUTHORIZED",
              "message": "Yêu cầu token xác thực (Authorization: Bearer <token>) để truy cập endpoint này.",
              "path": "/api/assets"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "GatewayError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      },
      "AssetInput": {
        "type": "object",
        "required": [
          "user_id",
          "asset_name",
          "asset_type"
        ],
        "properties": {
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "asset_name": {
            "type": "string",
            "maxLength": 100
          },
          "asset_type": {
            "type": "string",
            "maxLength": 50,
            "description": "VD: BANK_ACCOUNT, CASH, REAL_ESTATE, CRYPTO, STOCK, EQUIPMENT"
          },
          "purchase_price": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "current_value": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "salvage_value": {
            "type": "number",
            "minimum": 0,
            "default": 0
          },
          "useful_life_years": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "purchase_date": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "maxLength": 10,
            "default": "VND",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AssetListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "user_id": {
            "type": "integer",
            "format": "int64"
          },
          "asset_name": {
            "type": "string"
          },
          "asset_type": {
            "type": "string"
          },
          "purchase_price": {
            "type": "number"
          },
          "current_value": {
            "type": "number"
          },
          "salvage_value": {
            "type": "number"
          },
          "useful_life_years": {
            "type": "integer"
          },
          "purchase_date": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "currency": {
            "type": "string",
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Asset": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AssetListItem"
          },
          {
            "type": "object",
            "properties": {
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "LoanInput": {
        "type": "object",
        "required": [
          "user_id",
          "loan_title",
          "principal_amount",
          "interest_rate",
          "term_months",
          "start_date"
        ],
        "properties": {
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "loan_title": {
            "type": "string",
            "maxLength": 150
          },
          "principal_amount": {
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "interest_rate": {
            "type": "number",
            "minimum": 0,
            "description": "Lãi suất %/năm"
          },
          "term_months": {
            "type": "integer",
            "minimum": 1
          },
          "start_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "LoanListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "user_id": {
            "type": "integer",
            "format": "int64"
          },
          "loan_title": {
            "type": "string"
          },
          "principal_amount": {
            "type": "number"
          },
          "interest_rate": {
            "type": "number"
          },
          "term_months": {
            "type": "integer"
          },
          "start_date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "CLOSED"
            ]
          }
        }
      },
      "Loan": {
        "allOf": [
          {
            "$ref": "#/components/schemas/LoanListItem"
          },
          {
            "type": "object",
            "properties": {
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "InvestmentInput": {
        "type": "object",
        "required": [
          "user_id",
          "symbol",
          "investment_type",
          "quantity",
          "buy_price",
          "current_price"
        ],
        "properties": {
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "symbol": {
            "type": "string",
            "maxLength": 20
          },
          "investment_type": {
            "type": "string",
            "maxLength": 50,
            "description": "VD: STOCK, CRYPTO, GOLD, BOND"
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": true,
            "minimum": 0
          },
          "buy_price": {
            "type": "number",
            "minimum": 0
          },
          "current_price": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "InvestmentListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "user_id": {
            "type": "integer",
            "format": "int64"
          },
          "symbol": {
            "type": "string"
          },
          "investment_type": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "buy_price": {
            "type": "number"
          },
          "current_price": {
            "type": "number"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Investment": {
        "allOf": [
          {
            "$ref": "#/components/schemas/InvestmentListItem"
          },
          {
            "type": "object",
            "properties": {
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "DeleteSuccess": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  }
}
