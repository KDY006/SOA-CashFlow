    },
    "schemas": {
      "NotificationError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "string",
            "example": "VALIDATION_ERROR"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "userId": {
            "type": "integer",
            "example": 1
          },
          "type": {
            "type": "string",
            "description": "Vd SYSTEM, BUDGET_ALERT, CASHFLOW_ANOMALY, LOAN_REMINDER, LARGE_TRANSACTION, TRANSACTION_REJECTED",
            "example": "BUDGET_ALERT"
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true
          },
          "isRead": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "readAt": {
            "type": "string",
