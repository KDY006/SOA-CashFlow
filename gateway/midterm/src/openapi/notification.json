{
  "openapi": "3.0.3",
  "info": {
    "title": "Notification Service (Node.js)",
    "version": "1.0.0-midterm",
    "description": "Notification Service viết bằng **Node.js thuần (node:http, zero-dependency)**, chạy nội bộ ở cổng **8086**, truy cập qua API Gateway (:8080) với prefix `/api/notifications`.\n\nLưu thông báo trong bộ nhớ (in-memory, có seed dữ liệu mẫu cho user 1 và 2), đẩy realtime qua **Server-Sent Events** và đồng bộ giữa các instance qua **Redis Pub/Sub**.\n\n- Xác định user theo thứ tự: path `{userId}` → query `user_id` → body `userId`/`user_id` (POST) → header `X-User-Id` (Gateway gắn từ JWT) → mặc định `1`.\n- Dấu `/` cuối đường dẫn được bỏ qua.\n- `GET /health` của service không đi qua Gateway được (Gateway tự trả `/health` của nó)."
  },
  "servers": [
    {
      "url": "/",
      "description": "Qua API Gateway"
    }
  ],
  "tags": [
    {
      "name": "Thông báo",
      "description": "Lịch sử, tạo mới, đánh dấu đã đọc"
    },
    {
      "name": "Realtime (SSE)",
      "description": "Kênh đẩy thông báo thời gian thực"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/notifications": {
      "get": {
        "tags": [
          "Thông báo"
        ],
        "operationId": "listMyNotifications",
        "summary": "Lấy danh sách thông báo của user hiện tại",
        "description": "Mới nhất trước. `total` là tổng số sau khi lọc, `unreadCount` là số chưa đọc của user.",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "description": "**Chỉ ADMIN dùng được** — xem dữ liệu của user khác (vd 1, 2, 3...). Tài khoản USER thường: tham số này bị bỏ qua, luôn trả dữ liệu của chính mình (lấy userId từ JWT). Bỏ trống = dữ liệu của user đang đăng nhập.",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Số bản ghi tối đa",
            "schema": {
              "type": "integer",
              "default": 50
            },
            "example": 20
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Vị trí bắt đầu",
            "schema": {
              "type": "integer",
              "default": 0
            },
            "example": 0
          },
          {
            "name": "unread_only",
            "in": "query",
            "required": false,
            "description": "Chỉ lấy thông báo chưa đọc (chỉ đúng khi giá trị là chuỗi \"true\")",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "default": "false"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách thông báo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationListResponse"
                },
                "example": {
                  "success": true,
                  "userId": 1,
                  "items": [
                    {
                      "id": 1,
                      "userId": 1,
                      "type": "BUDGET_ALERT",
                      "title": "Cảnh báo Ngân sách tháng 10/2026",
                      "message": "Giao dịch gần nhất đã làm ngân sách danh mục 'Ăn uống & Cà phê' vượt hạn mức (Đã chi 5,450,000 / 5,000,000 VND).",
                      "metadata": {
                        "categoryId": 3,
                        "limit": 5000000,
                        "spent": 5450000,
                        "overAmount": 450000
                      },
                      "isRead": false,
                      "createdAt": "2026-10-20T07:30:00.000Z"
                    },
                    {
                      "id": 2,
                      "userId": 1,
                      "type": "CASHFLOW_ANOMALY",
                      "title": "Phát hiện Chi tiêu Bất thường (Analytics)",
                      "message": "Khoản chi 3,500,000 VND cho Tiền nhà & Tiện ích vượt xa mức trung vị chi tiêu thông thường.",
                      "metadata": {
                        "amount": 3500000,
                        "category": "Tiền nhà & Tiện ích",
                        "median": 450000
                      },
                      "isRead": false,
                      "createdAt": "2026-10-20T04:30:00.000Z"
                    }
                  ],
                  "total": 3,
                  "unreadCount": 2
                }
              }
            }
          },
          "401": {
            "description": "Thiếu hoặc sai JWT (do Gateway trả về)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationError"
                },
                "example": {
                  "success": false,
                  "error": "UNAUTHORIZED",
                  "message": "Yêu cầu token xác thực (Authorization: Bearer <token>) để truy cập endpoint này."
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Thông báo"
        ],
        "operationId": "createNotification",
        "summary": "Tạo và phát thông báo mới (alias của /send)",
        "description": "Giống hệt `POST /api/notifications/send`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendNotificationRequest"
              },
              "example": {
                "userId": 1,
                "title": "Biến động số dư lớn",
                "message": "Tài khoản VCB + 15.000.000 đ. Số dư: 30.250.000 đ",
                "type": "LARGE_TRANSACTION",
                "metadata": {
                  "bank_tx_id": 101,
                  "external_ref": "FT26293001234"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đã lưu và phát thông báo (SSE + Redis Pub/Sub)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendNotificationResponse"
                },
                "example": {
                  "success": true,
                  "message": "Tạo và phát thông báo thành công",
                  "data": {
                    "id": 5,
                    "userId": 1,
                    "type": "LARGE_TRANSACTION",
                    "title": "Biến động số dư lớn",
                    "message": "Tài khoản VCB + 15.000.000 đ. Số dư: 30.250.000 đ",
                    "metadata": {
                      "bank_tx_id": 101,
                      "external_ref": "FT26293001234"
                    },
                    "isRead": false,
                    "createdAt": "2026-10-20T09:45:12.345Z"
                  },
                  "realtimeDelivered": true,
                  "activeClients": 1
                }
              }
            }
          },
          "400": {
            "description": "Thiếu title hoặc message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationError"
                },
                "example": {
                  "success": false,
                  "error": "VALIDATION_ERROR",
                  "message": "Tiêu đề (title) và nội dung (message) là bắt buộc"
                }
              }
            }
          },
          "401": {
            "description": "Thiếu hoặc sai JWT (do Gateway trả về)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationError"
                },
                "example": {
                  "success": false,
                  "error": "UNAUTHORIZED",
                  "message": "Yêu cầu token xác thực (Authorization: Bearer <token>) để truy cập endpoint này."
                }
              }
            }
          },
          "500": {
            "description": "Lỗi xử lý (vd JSON body sai định dạng, payload > 1MB)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationError"
                },
                "example": {
                  "success": false,
                  "error": "INTERNAL_SERVER_ERROR",
                  "message": "Định dạng JSON gửi lên không hợp lệ"
                }
              }
            }
          }
        }
      }
    },
    "/api/notifications/send": {
      "post": {
        "tags": [
          "Thông báo"
        ],
        "operationId": "sendNotification",
        "summary": "Gửi thông báo mới cho người dùng",
