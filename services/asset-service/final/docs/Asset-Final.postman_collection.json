{
  "info": {
    "name": "CashFlow - Asset Service Final",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run with a disposable test DB. Set ACCESS_TOKEN manually or run Login via Gateway first. CRUD creates and deletes temporary records. BASE_URL can be direct or Gateway."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{ACCESS_TOKEN}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8083"
    },
    {
      "key": "DIRECT_URL",
      "value": "http://localhost:8083"
    },
    {
      "key": "GATEWAY_URL",
      "value": "http://localhost:8080"
    },
    {
      "key": "ACCESS_TOKEN",
      "value": ""
    },
    {
      "key": "USERNAME",
      "value": "admin"
    },
    {
      "key": "PASSWORD",
      "value": "password123"
    },
    {
      "key": "ASSET_ID",
      "value": ""
    },
    {
      "key": "LOAN_ID",
      "value": ""
    },
    {
      "key": "INVESTMENT_ID",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health and auth",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{DIRECT_URL}}/health",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{DIRECT_URL}}/health/ready",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject spoofed identity / missing JWT",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "1"
              },
              {
                "key": "X-User-Role",
                "value": "ADMIN"
              }
            ],
            "url": "{{DIRECT_URL}}/api/assets",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login via Gateway (optional if ACCESS_TOKEN already set)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{GATEWAY_URL}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{USERNAME}}\",\n  \"password\": \"{{PASSWORD}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const b=pm.response.json(); const d=b.data||b; const t=d.access_token||d.accessToken||d.token; pm.test(\"JWT returned\",()=>pm.expect(t).to.be.a(\"string\")); if(t) pm.collectionVariables.set(\"ACCESS_TOKEN\",t);"
                ]
              }
            }
          ]
        }
      ]
    },
