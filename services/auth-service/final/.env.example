# Sao chép thành .env và điền giá trị. Spring Boot không tự nạp tệp này.
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8081
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=auth_db
DB_USER=root
DB_PASSWORD=
JWT_SECRET=
AUTH_CORS_ORIGINS=

# Tuỳ chọn cho Compose. Giá trị bên dưới là cổng trên máy chủ.
AUTH_SERVICE_PORT=8081
GATEWAY_PORT=8080
