# ==============================================================================
# GLOBAL & SYSTEM CONFIGURATION
# ==============================================================================
APP_ENV=development
APP_SECRET=super-secret-jwt-key-cashflow-2026
# ==============================================================================
# SERVICE PORTS (HOST MAPPING)
# ==============================================================================
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
TRANSACTION_SERVICE_PORT=8082
ASSET_SERVICE_PORT=8083
ANALYTICS_SERVICE_PORT=8084
INTEGRATION_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
# ==============================================================================
# DATABASE CONFIGURATIONS (5 MySQL + 1 Redis)
# ==============================================================================
# Auth Service DB (MySQL)
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=3306
AUTH_DB_NAME=auth_db
AUTH_DB_USER=root
AUTH_DB_PASSWORD=root_password
# Transaction Service DB (MySQL)
TRANSACTION_DB_HOST=transaction-db
TRANSACTION_DB_PORT=3306
TRANSACTION_DB_NAME=transaction_db
TRANSACTION_DB_USER=root
TRANSACTION_DB_PASSWORD=root_password
# Asset Service DB (MySQL)
ASSET_DB_HOST=asset-db
ASSET_DB_PORT=3306
ASSET_DB_NAME=asset_db
ASSET_DB_USER=root
ASSET_DB_PASSWORD=root_password
# Integration Service DB (MySQL)
INTEGRATION_DB_HOST=integration-db
INTEGRATION_DB_PORT=3306
INTEGRATION_DB_NAME=integration_db
INTEGRATION_DB_USER=root
INTEGRATION_DB_PASSWORD=root_password
# Analytics Service DB (MySQL)
ANALYTICS_DB_HOST=analytics-db
ANALYTICS_DB_PORT=3306
ANALYTICS_DB_NAME=analytics_db
ANALYTICS_DB_USER=root
ANALYTICS_DB_PASSWORD=root_password
# Shared Cache / Message Broker (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
